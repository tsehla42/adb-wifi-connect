# adb-wifi-connect configuration
# Copy this file to .env and edit, or export the variables in your shell.
# Precedence: real environment variable > ./.env > ~/.config/awc/.env

# Prefills the --direct IP prompt; flow.connect() (Python API) falls back
# to it after failed discovery. The no-arg awc CLI does NOT read it when
# discovery finds nothing (it waits for a QR scan or fails fast).
AWC_DEFAULT_IP=192.168.1.100
